function get_length with word do
  set counter to 0
  for each letter in word do
    change counter to counter + 1
  end
  return counter
end

function handle_guest with name, allowed_prefix do
  if get_length(allowed_prefix) > get_length(name) do
    return false
  end

  set counter to 1
  for each letter in allowed_prefix do
    if letter != name[counter] do
      return false
    end
    change counter to counter + 1
  end
  return true
end
