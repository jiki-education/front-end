set present to []
set absent to []
set actuals to ["", "", "", "", ""]
set nots to [[], [], [], [], []]

function letter_ok_in_guess with letter, idx do
  if actuals[idx] != "" do
    return letter == actuals[idx]
  end
  if absent.includes(letter) do
    return false
  end
  return not nots[idx].includes(letter)
end

function is_word_possible with word do
  for each char in word indexed by idx do
    if not letter_ok_in_guess(char, idx) do
      return false
    end
  end
  for each char in present do
    if not word.includes(char) do
      return false
    end
  end
  return true
end

function choose_word do
  for each candidate in common_words() do
    if is_word_possible(candidate) do
      return candidate
    end
  end
end

function is_found_elsewhere with word, states, letter do
  for each char in word indexed by idx do
    if char == letter and states[idx] != "absent" do
      return true
    end
  end
  return false
end

function record_knowledge with word, states do
  for each letter in word indexed by idx do
    if states[idx] == "correct" do
      change actuals[idx] to letter
    else if states[idx] == "present" do
      if not present.includes(letter) do
        present.push(letter)
      end
      nots[idx].push(letter)
    else if not is_found_elsewhere(word, states, letter) do
      if not absent.includes(letter) do
        absent.push(letter)
      end
    end
  end
end

function has_won with states do
  for each state in states do
    if state != "correct" do
      return false
    end
  end
  return true
end

function solve_wordle do
  repeat 6 times do
    set word to choose_word()
    set states to guess(word)
    record_knowledge(word, states)
    if has_won(states) do
      break
    end
  end
end
