function sign_words with business_name do
  set words to []
  set word to ""
  for each letter in business_name do
    if letter == " " do
      if word != "" do
        change words to push(words, word)
      end
      change word to ""
    else do
      change word to concatenate(word, letter)
    end
  end
  if word != "" do
    change words to push(words, word)
  end
  return words
end
