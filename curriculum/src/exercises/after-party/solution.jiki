function length with word do
  set counter to 0
  for each letter in word do
    change counter to counter + 1
  end
  return counter
end

function is_called with name, person do
  set name_length to length(name)
  set person_length to length(person)
  if person_length > name_length do
    return false
  end

  set counter to 1
  for each letter in person do
    if letter != name[counter] do
      return false
    end
    change counter to counter + 1
  end

  if person_length == name_length or name[counter] == " " do
    return true
  end
  return false
end

function plus_ones_for with names, plus_ones, person do
  for each name in names indexed by idx do
    if is_called(name, person) do
      return plus_ones[idx]
    end
  end
  return "Not on the list!"
end
